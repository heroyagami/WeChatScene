    },
    {
      "id": "18",
      "role": "left",
      "text": "属于合理的上下班路线"
    },
    {
      "id": "19",
      "role": "left",
      "text": "交通事故中本人非主要责任"
    },
    {
      "id": "20",
      "role": "right",
      "text": "我次责符合第三点吗"
    },
    {
      "id": "21",
      "role": "left",
      "text": "次责通常属于本人非主要责任"
    },
    {
      "id": "22",
      "role": "left",
      "text": "责任认定书是关键材料"
    },
    {
      "id": "23",
      "role": "right",
      "text": "公司不同意就不能申请吗"
