    },
    {
      "id": "153",
      "role": "left",
      "text": "先保留心理或复诊的真实记录"
    },
    {
      "id": "154",
      "role": "right",
      "text": "如果鉴定说延误只占一部分呢"
    },
    {
      "id": "155",
      "role": "left",
      "text": "责任可能按原因力和过错划分"
    },
    {
      "id": "156",
      "role": "left",
      "text": "并非只有全赔或不赔两种结果"
    },
    {
      "id": "157",
      "role": "left",
      "text": "孩子自身疾病也会纳入判断"
    },
    {
      "id": "158",
      "role": "left",
      "text": "家校各自行为同样会被审查"
    },
    {
      "id": "159",
      "role": "right",
      "text": "学校愿意先给五千医疗费"
    },
    {
      "id": "160",
      "role": "left",
      "text": "可以明确写成临时垫付款"
    },
    {
      "id": "161",
      "role": "left",
      "text": "不要写一次性结清全部责任"
    },
    {
      "id": "162",
      "role": "left",
      "text": "也不要先承认学校完全无责"
    },
    {
      "id": "163",
      "role": "right",
      "text": "他们让我签安全事故和解书"
    },
    {
      "id": "164",
      "role": "left",
      "text": "先看是否含放弃后续权利"
    },
    {
      "id": "165",
      "role": "left",
      "text": "伤情和因果未明时谨慎签署"
    },
    {
      "id": "166",
      "role": "left",
      "text": "可提出待鉴定后再最终结算"
    },
    {
      "id": "167",
      "role": "right",
      "text": "我可以在家长群曝光吗"
    },
    {
      "id": "168",
      "role": "left",
      "text": "不建议公开孩子隐私和教师信息"
    },
    {
      "id": "169",
      "role": "left",
      "text": "也不要使用侮辱或确定罪名"
    },
    {
      "id": "170",
      "role": "left",
      "text": "维权内容控制在必要范围"
    },
    {
      "id": "171",
      "role": "left",
      "text": "避免衍生名誉和隐私争议"
    },
    {
      "id": "172",
      "role": "right",
      "text": "我现在具体怎么做"
    },
    {
      "id": "173",
      "role": "left",
      "text": "第一，完善病历和治疗资料"
    },
    {
      "id": "174",
      "role": "left",
      "text": "第二，立即发监控保全通知"
    },
    {
      "id": "175",
      "role": "left",
      "text": "第三，固定通话、出行和证言"
    },
    {
      "id": "176",
      "role": "left",
      "text": "第四，书面索取校内记录"
    },
    {
      "id": "177",
      "role": "left",
      "text": "第五，向学校和保险申报损失"
    },
    {
      "id": "178",
      "role": "left",
      "text": "第六，必要时评估因果鉴定"
    },
    {
      "id": "179",
      "role": "left",
      "text": "协商不成再考虑诉讼"
    },
    {
      "id": "180",
      "role": "right",
      "text": "起诉前一定要先鉴定吗"
    },
    {
      "id": "181",
      "role": "left",
      "text": "不一定，可结合材料决定时点"
    },
    {
      "id": "182",
      "role": "left",
      "text": "有的鉴定需法院委托更稳妥"
    },
    {
      "id": "183",
      "role": "left",
      "text": "先避免单方选机构引发争议"
    },
    {
      "id": "184",
      "role": "right",
      "text": "应该告学校还是教育局"
    },
    {
      "id": "185",
      "role": "left",
      "text": "通常先看学校法人和第三方主体"
    },
    {
      "id": "186",
      "role": "left",
      "text": "教育局监管不等于当然赔偿"
    },
    {
      "id": "187",
      "role": "left",
      "text": "公办学校也有独立责任主体资格"
    },
    {
      "id": "188",
      "role": "left",
      "text": "具体名称以登记信息为准"
    },
    {
      "id": "189",
      "role": "right",
      "text": "去哪里起诉"
    },
    {
      "id": "190",
      "role": "left",
      "text": "一般可考虑侵权地或被告住所地"
    },
    {
      "id": "191",
      "role": "left",
      "text": "具体管辖需结合主体再核实"
    },
    {
      "id": "192",
      "role": "right",
      "text": "诉讼时效多久"
    },
    {
      "id": "193",
      "role": "left",
      "text": "人身损害通常适用三年时效"
    },
    {
      "id": "194",
      "role": "left",
      "text": "从知道损害和义务人时起算"
    },
    {
      "id": "195",
      "role": "left",
      "text": "未成年人规则还需结合请求判断"
    },
    {
      "id": "196",
      "role": "left",
      "text": "不要因此拖延证据保全"
    },
    {
      "id": "197",
      "role": "right",
      "text": "学校说没制度也不代表有错"
    },
    {
      "id": "198",
      "role": "left",
      "text": "制度缺失只是审查因素之一"
    },
    {
      "id": "199",
      "role": "left",
      "text": "核心仍是当时是否尽合理义务"
    },
    {
      "id": "200",
      "role": "left",
      "text": "以及延误是否造成损害加重"
    },
    {
      "id": "201",
      "role": "right",
      "text": "我先治疗，再发保全通知"
    },
    {
      "id": "202",
      "role": "left",
      "text": "对，通知中写明具体时间地点"
    },
    {
      "id": "203",
