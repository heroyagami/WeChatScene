    {
      "id": "07",
      "role": "left",
      "text": "先确认这笔钱是否已经到账"
    },
    {
      "id": "08",
      "role": "right",
      "text": "账单显示对方已收款"
    },
    {
      "id": "09",
      "role": "left",
      "text": "你和收款人以前有交易吗"
    },
    {
      "id": "10",
      "role": "right",
      "text": "没有，是输错了一个手机号"
    },
    {
      "id": "11",
      "role": "left",
      "text": "有没有欠过对方钱或送过钱"
    },
    {
      "id": "12",
      "role": "right",
      "text": "完全不认识，也没有任何往来"
    },
    {
      "id": "13",
      "role": "left",
      "text": "那通常属于没有依据取得利益"
    },
    {
      "id": "14",
      "role": "left",
      "text": "可按不当得利要求返还"
    },
    {
      "id": "15",
      "role": "right",
      "text": "对方说钱进了账户就是他的"
    },
    {
      "id": "16",
      "role": "left",
      "text": "到账不等于取得合法所有权"
    },
    {
      "id": "17",
      "role": "left",
      "text": "误转事实和无付款义务是关键"
    },
    {
      "id": "18",
      "role": "right",
      "text": "我第一步应该做什么"
    },
    {
      "id": "19",
      "role": "left",
      "text": "立即联系微信支付和开户银行"
    },
    {
      "id": "20",
      "role": "left",
      "text": "申请止付、追回并取得工单号"
    },
    {
      "id": "21",
      "role": "left",
      "text": "让客服保全实名和账户信息"
    },
    {
      "id": "22",
      "role": "right",
      "text": "客服会把对方身份给我吗"
    },
    {
      "id": "23",
      "role": "left",
      "text": "通常不会直接向个人披露"
    },
    {
      "id": "24",
      "role": "left",
      "text": "但可向法院或有权机关提供"
    },
    {
      "id": "25",
      "role": "right",
      "text": "现有证据要怎么保存"
    },
    {
      "id": "26",
      "role": "left",
      "text": "导出完整账单和电子回单"
    },
    {
      "id": "27",
      "role": "left",
      "text": "保存订单号、时间和收款账号"
    },
    {
      "id": "28",
      "role": "left",
      "text": "录屏展示转账路径和联系人"
    },
    {
      "id": "29",
      "role": "left",
      "text": "保留对方承认收款的原始聊天"
    },
    {
      "id": "30",
      "role": "left",
      "text": "电话沟通可依法录音留证"
    },
    {
      "id": "31",
      "role": "right",
      "text": "能不能把他信息发网上曝光"
    },
    {
      "id": "32",
      "role": "left",
      "text": "不要公开姓名、头像和手机号"
    },
    {
      "id": "33",
      "role": "left",
      "text": "公开施压可能引发新的侵权"
    },
    {
      "id": "34",
      "role": "right",
      "text": "报警能按侵占处理吗"
    },
    {
      "id": "35",
      "role": "left",
      "text": "单纯拒还通常先按民事纠纷处理"
    },
    {
      "id": "36",
      "role": "left",
      "text": "若有诈骗线索再如实向警方反映"
    },
    {
      "id": "37",
      "role": "left",
      "text": "不要用坐牢等话术威胁对方"
    },
    {
      "id": "38",
      "role": "right",
      "text": "联系不上对方怎么起诉"
    },
    {
      "id": "39",
      "role": "left",
      "text": "先整理可定位账户的全部信息"
    },
    {
      "id": "40",
      "role": "left",
      "text": "立案后可申请法院调查实名资料"
    },
    {
      "id": "41",
      "role": "left",
      "text": "也可评估律师调查令等方式"
    },
    {
      "id": "42",
      "role": "right",
      "text": "应该去哪个法院"
    },
    {
      "id": "43",
      "role": "left",
      "text": "通常先看被告住所地等管辖连接"
    },
    {
      "id": "44",
      "role": "left",
      "text": "身份查清后再确定具体法院"
    },
    {
      "id": "45",
      "role": "right",
      "text": "可以要求对方支付利息吗"
    },
    {
      "id": "46",
      "role": "left",
      "text": "本金返还通常是主要请求"
    },
    {
      "id": "47",
      "role": "left",
      "text": "明知误收仍占用会影响利息判断"
    },
    {
      "id": "48",
      "role": "left",
      "text": "起算时间和标准要结合催告证据"
    },
    {
      "id": "49",
      "role": "left",
      "text": "不能预先承诺法院一定支持"
    },
    {
      "id": "50",
      "role": "right",
      "text": "他把钱花掉了还能要求返还吗"
    },
    {
      "id": "51",
      "role": "left",
      "text": "花掉一般不当然免除返还义务"
    },
    {
      "id": "52",
      "role": "left",
      "text": "但实际执行还要看其财产情况"
    },
    {
      "id": "53",
      "role": "right",
      "text": "担心他转移财产怎么办"
    },
    {
      "id": "54",
      "role": "left",
      "text": "有明确线索可评估财产保全"
    },
    {
      "id": "55",
      "role": "left",
      "text": "保全通常需提供担保和具体财产"
    },
    {
      "id": "56",
      "role": "right",
      "text": "这类案件有没有时间限制"
    },
    {
      "id": "57",
      "role": "left",
      "text": "一般诉讼时效为三年"
    },
    {
      "id": "58",
      "role": "left",
      "text": "通常从知道损失和义务人起算"
    },
    {
      "id": "59",
      "role": "left",
      "text": "催款要留痕，但不要拖到临期"
    },
    {
      "id": "60",
      "role": "right",
      "text": "我按什么顺序处理最稳妥"
    },
    {
      "id": "61",
      "role": "left",
      "text": "先申请止付并固定电子证据"
    },
    {
      "id": "62",
      "role": "left",
      "text": "再书面催告对方限期返还"
    },
    {
      "id": "63",
      "role": "left",
      "text": "同步请求平台保存账户资料"
    },
    {
      "id": "64",
      "role": "left",
      "text": "拒不返还就准备不当得利诉讼"
    },
    {
      "id": "65",
      "role": "left",
      "text": "必要时一并评估财产保全"
    },
    {
      "id": "66",
      "role": "right",
      "text": "我先整理回单和聊天记录"
    },
    {
      "id": "67",
      "role": "left",
      "text": "对，今天就联系平台并书面催告"
    },
