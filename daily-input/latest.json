      "role": "right",
      "text": "现在二次手术很急"
    },
    {
      "id": "149",
      "role": "left",
      "text": "治疗安全优先"
    },
    {
      "id": "150",
      "role": "left",
      "text": "术前书面通知医院共同见证取出"
    },
    {
      "id": "151",
      "role": "left",
      "text": "手术记录写明断裂位置和状态"
    },
    {
      "id": "152",
      "role": "left",
      "text": "请医生拍摄取出前后的影像"
    },
    {
      "id": "153",
      "role": "left",
      "text": "取出后立即完成清点和封存"
    },
    {
      "id": "154",
      "role": "left",
      "text": "若医院拒绝要留书面或视频证据"
    },
    {
      "id": "155",
      "role": "right",
      "text": "二次手术费谁先付"
    },
    {
      "id": "156",
      "role": "left",
      "text": "先避免因费用耽误必要治疗"
    },
    {
      "id": "157",
      "role": "left",
      "text": "可要求医院或厂家先行垫付"
