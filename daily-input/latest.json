      "transferAmount": "500.00",
      "transferState": "accepted"
    },
    { "id": "06", "role": "left", "text": "收到" },
    {
      "id": "fee-receipt",
      "role": "left",
      "text": "",
      "kind": "transfer",
      "transferId": "consultation-fee",
      "transferAmount": "500.00",
      "transferState": "received"
    },
    { "id": "07", "role": "left", "text": "还要核对公司撤回Offer的理由和时间" },
    { "id": "08", "role": "right", "text": "已经产生的损失可以主张吗" },
    {
      "id": "09",
      "role": "left",
      "text": "可以结合信赖损失和双方过错进一步判断"
    },
    {
      "id": "10",
      "role": "left",
      "text": "先整理证据和损失凭证，再确定处理方案"
    }
