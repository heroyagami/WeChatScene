    },
    {
      "id": "06",
      "role": "left",
      "text": "先别急着接受客服的赔付方案"
    },
    {
      "id": "07",
      "role": "left",
      "text": "先确认下单方式和承运主体"
    },
    {
      "id": "08",
      "role": "right",
      "text": "我在快递小程序下单，上门取件"
    },
    {
      "id": "09",
      "role": "left",
      "text": "运单是谁开的"
    },
    {
      "id": "10",
      "role": "right",
      "text": "运单显示这家快递公司"
    },
    {
      "id": "11",
      "role": "left",
      "text": "客服是否已书面确认丢失"
    },
    {
      "id": "12",
      "role": "right",
      "text": "工单写着运输途中遗失"
    },
    {
      "id": "13",
      "role": "left",
      "text": "相机是新的还是使用过的"
    },
    {
      "id": "14",
      "role": "right",
      "text": "用了八个月，寄去给朋友拍摄"
    },
    {
      "id": "15",
      "role": "left",
      "text": "装箱时有没有拍视频"
    },
    {
      "id": "16",
      "role": "right",
      "text": "拍了，机身和镜头序列号都清楚"
    },
    {
      "id": "17",
      "role": "left",
      "text": "发票、付款记录还在吗"
    },
    {
      "id": "18",
      "role": "right",
      "text": "都在，购买价是两万三千元"
    },
    {
      "id": "19",
      "role": "left",
      "text": "先把价值和交寄证据固定完整"
    },
    {
      "id": "20",
      "role": "left",
      "text": "保存订单、运单和支付记录"
    },
    {
      "id": "21",
      "role": "left",
      "text": "导出全程物流轨迹和异常节点"
    },
    {
      "id": "22",
      "role": "left",
      "text": "留存装箱视频及取件交接记录"
    },
    {
      "id": "23",
      "role": "left",
      "text": "发票、型号和序列号一并保存"
    },
    {
      "id": "24",
      "role": "left",
      "text": "客服工单和通话录音也要备份"
    },
    {
      "id": "25",
      "role": "right",
      "text": "他们说条款写了未保价限赔"
    },
    {
      "id": "26",
      "role": "left",
      "text": "先调取你下单时适用的完整条款"
    },
    {
      "id": "27",
      "role": "left",
      "text": "不要只看客服后来发的截图"
    },
    {
      "id": "28",
      "role": "left",
      "text": "重点看限赔条款如何展示"
    },
    {
      "id": "29",
      "role": "left",
      "text": "还要看是否曾作显著提示和说明"
    },
    {
      "id": "30",
      "role": "right",
      "text": "我下单时只勾了同意协议"
    },
    {
      "id": "31",
      "role": "left",
      "text": "仅有勾选不等于条款当然有效"
    },
    {
      "id": "32",
      "role": "left",
      "text": "但也不能据此直接认定条款无效"
    },
    {
      "id": "33",
      "role": "left",
      "text": "要结合字体、位置和操作流程判断"
    },
    {
      "id": "34",
      "role": "right",
      "text": "法律上未保价怎么赔"
    },
    {
      "id": "35",
      "role": "left",
      "text": "未保价不当然等于只赔运费倍数"
    },
    {
      "id": "36",
      "role": "left",
      "text": "也不当然能按购买价全额赔偿"
    },
    {
      "id": "37",
      "role": "left",
      "text": "先看双方有没有有效赔偿约定"
    },
    {
      "id": "38",
      "role": "left",
      "text": "约定不明时再看交付地市场价格"
    },
    {
      "id": "39",
      "role": "left",
      "text": "法律另有限额规定的还要具体适用"
    },
    {
      "id": "40",
      "role": "right",
      "text": "快递丢了也可能不负责吗"
    },
    {
      "id": "41",
      "role": "left",
      "text": "承运人原则上要对货物灭失担责"
    },
    {
      "id": "42",
      "role": "left",
      "text": "但能证明法定免责原因的除外"
    },
    {
      "id": "43",
      "role": "left",
      "text": "例如货物自然性质或寄件人过错"
    },
    {
      "id": "44",
      "role": "left",
      "text": "普通内部管理失误通常难以免责"
    },
    {
      "id": "45",
      "role": "right",
      "text": "他们说没申报价值是我的错"
    },
    {
      "id": "46",
      "role": "left",
      "text": "未保价会影响风险分配和举证"
    },
    {
      "id": "47",
      "role": "left",
      "text": "但不必然免除承运人的基本责任"
    },
    {
      "id": "48",
      "role": "left",
      "text": "是否减轻责任要看具体条款和过错"
    },
    {
      "id": "49",
      "role": "right",
      "text": "七倍运费条款能推翻吗"
    },
    {
      "id": "50",
      "role": "left",
      "text": "要审查它是否属于格式条款"
    },
    {
      "id": "51",
      "role": "left",
      "text": "以及是否不合理减轻对方责任"
    },
    {
      "id": "52",
      "role": "left",
      "text": "若未履行提示说明义务可提出异议"
    },
    {
      "id": "53",
      "role": "left",
      "text": "若存在故意或重大过失也要另行审查"
    },
    {
      "id": "54",
      "role": "left",
      "text": "最终效力由协商或裁判机关判断"
    },
    {
      "id": "55",
      "role": "right",
      "text": "发票能证明损失就是两万三吗"
    },
    {
      "id": "56",
      "role": "left",
      "text": "发票能证明原购买价格"
    },
    {
      "id": "57",
      "role": "left",
      "text": "但二手相机还会考虑使用和折旧"
    },
    {
      "id": "58",
      "role": "left",
      "text": "同型号同期交易价格也有参考价值"
    },
    {
      "id": "59",
      "role": "left",
      "text": "镜头、配件要分别列清"
    },
    {
      "id": "60",
      "role": "left",
      "text": "必要时可申请评估实际价值"
    },
    {
      "id": "61",
      "role": "right",
      "text": "朋友说耽误拍摄也要赔"
    },
    {
      "id": "62",
      "role": "left",
      "text": "间接损失要看是否可预见"
    },
    {
      "id": "63",
      "role": "left",
      "text": "也要证明实际发生和因果关系"
    },
    {
      "id": "64",
      "role": "left",
      "text": "未提前告知用途时支持难度可能更大"
    },
    {
      "id": "65",
      "role": "left",
      "text": "不要先承诺朋友一定能获赔"
    },
    {
      "id": "66",
      "role": "right",
      "text": "相机里还有一张存储卡"
    },
    {
      "id": "67",
      "role": "left",
      "text": "立即列明存储卡也在包裹内"
    },
    {
      "id": "68",
      "role": "left",
      "text": "如含账号信息先修改相关密码"
    },
    {
      "id": "69",
      "role": "left",
      "text": "保存可能泄露内容的清单"
    },
    {
      "id": "70",
      "role": "left",
      "text": "发现外传再固定传播证据"
    },
    {
      "id": "71",
      "role": "right",
      "text": "现在该怎么和快递谈"
    },
    {
      "id": "72",
      "role": "left",
      "text": "先发一份书面索赔和证据清单"
    },
    {
      "id": "73",
      "role": "left",
      "text": "要求说明丢失环节和责任依据"
    },
    {
      "id": "74",
      "role": "left",
      "text": "同时要求保存分拣和交接记录"
    },
    {
      "id": "75",
      "role": "left",
      "text": "提出相机现值及合理损失方案"
    },
    {
      "id": "76",
      "role": "left",
      "text": "不要签含有全部结清的收款确认"
    },
    {
      "id": "77",
      "role": "right",
      "text": "他们一直拖着不处理怎么办"
    },
    {
      "id": "78",
      "role": "left",
      "text": "保存每次沟通时间和工单编号"
    },
    {
      "id": "79",
      "role": "left",
      "text": "先走企业内部升级投诉"
    },
    {
      "id": "80",
      "role": "left",
      "text": "仍无结果可向邮政管理部门申诉"
    },
    {
      "id": "81",
      "role": "left",
      "text": "也可根据合同约定选择诉讼"
    },
    {
      "id": "82",
      "role": "right",
      "text": "起诉前要注意什么"
    },
    {
      "id": "83",
      "role": "left",
      "text": "核对承运公司全称和注册地址"
    },
    {
      "id": "84",
      "role": "left",
      "text": "检查协议有无仲裁或管辖条款"
    },
    {
      "id": "85",
      "role": "left",
      "text": "整理交寄、丢失和价值三组证据"
    },
    {
      "id": "86",
      "role": "left",
      "text": "明确主张金额和计算依据"
    },
    {
      "id": "87",
      "role": "left",
      "text": "评估诉讼成本与可执行性"
    },
    {
      "id": "88",
      "role": "right",
      "text": "我现在按什么顺序处理"
    },
    {
      "id": "89",
      "role": "left",
      "text": "第一步固定订单、条款和物流证据"
    },
    {
      "id": "90",
      "role": "left",
      "text": "第二步补齐相机价值及装箱证明"
    },
    {
      "id": "91",
      "role": "left",
      "text": "第三步书面索赔并要求保存资料"
    },
    {
      "id": "92",
      "role": "left",
      "text": "第四步投诉或进入争议解决程序"
    },
    {
      "id": "93",
      "role": "right",
      "text": "明白，我先不点接受七倍运费"
    },
    {
      "id": "94",
      "role": "left",
      "text": "对，先审条款和证据再决定方案"
    },
