    {
      "id": "168",
      "role": "left",
      "text": "先按实际核算两次医疗费"
    },
    {
      "id": "169",
      "role": "left",
      "text": "还可核实护理、误工和交通费"
    },
    {
      "id": "170",
      "role": "left",
      "text": "营养费要结合医嘱和恢复需要"
    },
    {
      "id": "171",
      "role": "left",
      "text": "后续康复费需有医学依据"
    },
    {
      "id": "172",
      "role": "left",
      "text": "若遗留功能障碍再评估伤残"
    },
    {
      "id": "173",
      "role": "left",
      "text": "鉴定时点应在伤情相对稳定后"
    },
    {
      "id": "174",
      "role": "right",
      "text": "第一次手术费也能要求退吗"
    },
    {
      "id": "175",
      "role": "left",
      "text": "不能当然要求全部退还"
    },
    {
      "id": "176",
      "role": "left",
      "text": "第一次手术若有合理治疗价值"
    },
    {
      "id": "177",
      "role": "left",
      "text": "费用是否属于损失要具体判断"
    },
    {
      "id": "178",
      "role": "left",
      "text": "重复治疗和新增损害是重点"
    },
    {
      "id": "179",
      "role": "left",
      "text": "要避免把所有费用简单相加"
    },
    {
      "id": "180",
      "role": "right",
      "text": "精神损害能不能主张"
    },
    {
      "id": "181",
      "role": "left",
      "text": "达到较严重人身损害时可提出"
    },
    {
      "id": "182",
      "role": "left",
      "text": "金额结合后果和各方过错"
    },
    {
      "id": "183",
      "role": "left",
      "text": "不能预先承诺固定数额"
    },
    {
      "id": "184",
      "role": "right",
      "text": "我工资停了两个月"
    },
    {
      "id": "185",
      "role": "left",
      "text": "保存劳动合同和工资流水"
    },
    {
      "id": "186",
      "role": "left",
      "text": "让单位出具请假及扣薪证明"
    },
    {
      "id": "187",
      "role": "left",
      "text": "医嘱需能对应合理休息期限"
    },
    {
      "id": "188",
      "role": "left",
      "text": "收入波动时还要提供个税记录"
    },
    {
      "id": "189",
      "role": "right",
      "text": "医院愿意免二次手术费"
    },
    {
      "id": "190",
      "role": "left",
      "text": "先确认免的是哪些具体项目"
    },
    {
      "id": "191",
      "role": "left",
      "text": "不要因此签全部责任结清"
    },
    {
      "id": "192",
      "role": "left",
      "text": "可约定仅处理阶段性医疗费"
    },
    {
      "id": "193",
      "role": "left",
      "text": "写明不放弃后续合理损失"
    },
    {
      "id": "194",
      "role": "left",
      "text": "也不预先承认器材无缺陷"
    },
    {
      "id": "195",
      "role": "right",
      "text": "他们让我签自愿选材说明"
    },
    {
      "id": "196",
      "role": "left",
      "text": "不要补签倒签新的说明"
    },
    {
      "id": "197",
      "role": "left",
      "text": "原有文件可依法复制核对"
    },
    {
      "id": "198",
      "role": "left",
      "text": "补签会增加事实和时间争议"
    },
    {
      "id": "199",
      "role": "left",
      "text": "如需沟通只陈述真实经过"
    },
    {
      "id": "200",
      "role": "right",
      "text": "医院会不会改病历"
    },
    {
      "id": "201",
      "role": "left",
      "text": "不要先作无证据指控"
    },
    {
      "id": "202",
      "role": "left",
      "text": "立即申请复制和封存更有效"
    },
    {
      "id": "203",
      "role": "left",
      "text": "保留每次申请时间和经办人"
    },
    {
      "id": "204",
      "role": "left",
      "text": "发现前后版本不一致再核查"
    },
    {
      "id": "205",
      "role": "left",
      "text": "病历不真实可能影响过错推定"
    },
    {
      "id": "206",
      "role": "left",
      "text": "但仍需具体证据支持"
    },
    {
      "id": "207",
      "role": "right",
      "text": "起诉前先做什么"
    },
    {
      "id": "208",
      "role": "left",
      "text": "第一，复制并封存完整病历"
    },
    {
      "id": "209",
