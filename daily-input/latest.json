    {
      "id": "25",
      "role": "left",
      "text": "先书面通知公司并留送达记录"
    },
    {
      "id": "26",
      "role": "left",
      "text": "要求公司在法定期限内申请"
    },
    {
      "id": "27",
      "role": "right",
      "text": "公司最晚什么时候申请"
