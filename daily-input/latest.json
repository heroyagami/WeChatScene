      "id": "149",
      "role": "left",
      "text": "格式管辖条款还要审查提示效力"
    },
    {
      "id": "150",
      "role": "right",
      "text": "网上法院能不能直接起诉"
    },
    {
      "id": "151",
      "role": "left",
      "text": "要看有管辖权法院的线上立案渠道"
    },
    {
      "id": "152",
      "role": "left",
      "text": "按要求上传主体和证据材料"
    },
    {
      "id": "153",
      "role": "left",
      "text": "不要只上传零散聊天截图"
    },
    {
      "id": "154",
      "role": "right",
      "text": "起诉前需要发律师函吗"
