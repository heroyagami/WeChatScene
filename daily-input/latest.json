    {
      "id": "148",
      "role": "left",
      "text": "第二，立即书面要求封存监控"
    },
    {
      "id": "149",
      "role": "left",
      "text": "第三，固定乘客证言和超员视频"
    },
    {
      "id": "150",
      "role": "left",
      "text": "第四，提交交警和运输投诉记录"
    },
    {
      "id": "151",
      "role": "left",
      "text": "第五，整理损失清单并书面索赔"
    },
    {
      "id": "152",
      "role": "right",
      "text": "书面索赔要写哪些内容"
    },
    {
      "id": "153",
      "role": "left",
      "text": "写明班次、经过、伤情和证据目录"
    },
    {
      "id": "154",
      "role": "left",
      "text": "逐项列出已发生费用及计算依据"
    },
    {
      "id": "155",
      "role": "left",
      "text": "给对方合理答复期限并保存送达"
    },
    {
      "id": "156",
      "role": "right",
      "text": "投诉能直接拿到赔偿吗"
    },
    {
      "id": "157",
      "role": "left",
      "text": "投诉主要用于调查和推动协调"
    },
    {
      "id": "158",
      "role": "left",
      "text": "不保证直接解决全部民事赔偿"
    },
    {
      "id": "159",
      "role": "right",
      "text": "协商不成下一步呢"
    },
    {
      "id": "160",
      "role": "left",
      "text": "先确定被告和有管辖权的法院"
    },
    {
      "id": "161",
      "role": "left",
      "text": "准备起诉状、证据目录和损失表"
    },
    {
      "id": "162",
      "role": "left",
      "text": "金额较大时评估财产保全必要性"
    },
    {
      "id": "163",
      "role": "right",
      "text": "在哪里起诉比较方便"
    },
    {
      "id": "164",
      "role": "left",
      "text": "需结合被告住所和合同履行情况"
    },
    {
      "id": "165",
      "role": "left",
      "text": "具体管辖以案件材料和法院审查为准"
    },
    {
      "id": "166",
      "role": "right",
      "text": "诉讼时效多久"
    },
    {
      "id": "167",
      "role": "left",
      "text": "人身损害请求一般注意三年时效"
    },
    {
      "id": "168",
      "role": "left",
      "text": "起算和中断仍要结合具体事实"
    },
    {
      "id": "169",
      "role": "left",
      "text": "不要因持续协商而长期拖延"
    },
    {
      "id": "170",
      "role": "right",
      "text": "公司一直口头说会处理"
    },
    {
      "id": "171",
      "role": "left",
      "text": "把每次承诺转成可留痕的书面记录"
    },
    {
      "id": "172",
      "role": "left",
      "text": "定期书面催告并保留送达凭证"
    },
    {
      "id": "173",
      "role": "right",
      "text": "乘客不愿出庭怎么办"
    },
    {
      "id": "174",
      "role": "left",
      "text": "可先取得真实完整的书面陈述"
    },
    {
      "id": "175",
      "role": "left",
      "text": "但证人是否出庭会影响证明力度"
    },
    {
      "id": "176",
      "role": "right",
      "text": "监控拿不到还能起诉吗"
    },
    {
      "id": "177",
      "role": "left",
      "text": "可以，但证据是否充分需综合判断"
    },
    {
      "id": "178",
      "role": "left",
      "text": "提交你已要求保全的送达材料"
    },
    {
      "id": "179",
      "role": "left",
      "text": "再申请法院依法调查相关证据"
    },
    {
      "id": "180",
      "role": "right",
      "text": "公司拒不提交监控会怎样"
    },
    {
      "id": "181",
      "role": "left",
      "text": "法院会结合控制证据情况依法审查"
    },
    {
      "id": "182",
      "role": "left",
      "text": "不能预先保证一定作不利推定"
    },
    {
      "id": "183",
      "role": "right",
      "text": "我能在网上曝光这家公司吗"
    },
    {
      "id": "184",
      "role": "left",
      "text": "先走投诉和索赔程序更稳妥"
    },
    {
      "id": "185",
      "role": "left",
      "text": "公开内容要真实、必要且避免泄露隐私"
    },
    {
      "id": "186",
      "role": "left",
      "text": "不要用侮辱性语言或夸大未证实事实"
    },
    {
      "id": "187",
      "role": "right",
      "text": "最终能赔多少"
    },
    {
      "id": "188",
      "role": "left",
      "text": "取决于责任比例和有效损失证据"
    },
    {
      "id": "189",
      "role": "left",
      "text": "医疗、误工、护理等需逐项核算"
    },
    {
      "id": "190",
      "role": "left",
      "text": "伤残项目还要看鉴定结论"
    },
    {
      "id": "191",
      "role": "left",
      "text": "目前不能承诺固定金额或全额获赔"
    },
    {
      "id": "192",
      "role": "right",
      "text": "我先去封存监控并补报警"
    },
    {
      "id": "193",
      "role": "left",
      "text": "对，同时把今天沟通记录整理归档"
    },
    {
      "id": "194",
      "role": "left",
      "text": "索赔材料发出前再逐项核对"
    },
    {
      "id": "195",
      "role": "right",
      "text": "明白了，谢谢曹律"
    },
