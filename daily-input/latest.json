    {
      "id": "50",
      "role": "left",
      "text": "同时向肇事方和保险公司报案"
    },
    {
      "id": "51",
      "role": "left",
      "text": "工伤认定与交通索赔可同步推进"
    },
    {
      "id": "52",
      "role": "right",
      "text": "两边赔偿能都拿吗"
