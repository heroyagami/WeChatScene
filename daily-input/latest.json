{
  "date": "2026-09-15",
  "topic": "12岁孩子给主播打赏，家长能把钱追回来吗？",
  "source": "content/topic-sources/01-民法典课程目录.md：003",
  "readingCpm": 420,
  "bgm": "forest-friends",
  "bgmVolume": 0.45,
  "messages": [
    { "id": "01", "role": "right", "text": "曹律，我儿子偷偷给主播打赏" },
    { "id": "02", "role": "right", "text": "他才12岁，三个月花了两万八" },
    { "id": "03", "role": "right", "text": "钱是从我的微信里扣的" },
    { "id": "04", "role": "right", "text": "平台说账号实名是我，不肯退" },
    { "id": "05", "role": "left", "text": "500" },
    {
      "id": "fee-sent",
      "role": "right",
      "text": "",
      "kind": "transfer",
      "transferId": "consultation-fee",
      "transferAmount": "500.00",
      "transferState": "accepted"
    },
    { "id": "07", "role": "left", "text": "先说清楚，账号平时谁在用" },
    { "id": "08", "role": "right", "text": "手机是旧手机，主要给孩子上网课" },
    { "id": "09", "role": "left", "text": "充值和打赏是谁操作的" },
    { "id": "10", "role": "right", "text": "都是孩子，他承认了" },
    { "id": "11", "role": "left", "text": "你有没有替他刷过礼物" },
    { "id": "12", "role": "right", "text": "没有，我甚至不知道这个主播" },
    { "id": "13", "role": "left", "text": "支付密码孩子怎么知道的" },
    { "id": "14", "role": "right", "text": "他看我付款时记住了" },
    { "id": "15", "role": "left", "text": "打赏集中在什么时间" },
    { "id": "16", "role": "right", "text": "晚上和周末，还有几次在上课时" },
    { "id": "17", "role": "left", "text": "这些时间线很重要" },
    { "id": "18", "role": "left", "text": "12岁属于限制民事行为能力人" },
    { "id": "19", "role": "left", "text": "两万八明显超出日常零花范围" },
    { "id": "20", "role": "left", "text": "未经监护人同意，效力存在问题" },
    { "id": "21", "role": "right", "text": "是不是肯定能全退" },
    { "id": "22", "role": "left", "text": "不能先承诺一定全额退" },
    { "id": "23", "role": "left", "text": "关键是证明打赏确由孩子完成" },
    { "id": "24", "role": "left", "text": "还要看家长是否事后认可消费" },
    { "id": "25", "role": "right", "text": "平台说成年人实名就算我消费" },
    { "id": "26", "role": "left", "text": "实名信息不是唯一判断依据" },
    { "id": "27", "role": "left", "text": "设备、时段和直播内容都要结合" },
    { "id": "28", "role": "left", "text": "平台的未成年人识别也要核查" },
    { "id": "29", "role": "right", "text": "我现在应该先保存什么" },
    { "id": "30", "role": "left", "text": "先导出全部充值和礼物明细" },
    { "id": "31", "role": "left", "text": "保存微信账单和对应订单号" },
    { "id": "32", "role": "left", "text": "录屏账号主页、等级和关注记录" },
    { "id": "33", "role": "left", "text": "保留孩子使用手机的客观证据" },
    { "id": "34", "role": "left", "text": "上课时间打赏可结合考勤证明" },
    { "id": "35", "role": "left", "text": "再让孩子如实说明操作过程" },
    { "id": "36", "role": "right", "text": "要不要先把账号注销" },
    { "id": "37", "role": "left", "text": "先不要注销，也不要删除记录" },
    { "id": "38", "role": "left", "text": "证据保存后再申请未成年人退款" },
    { "id": "39", "role": "right", "text": "平台第一次拒绝了怎么办" },
    { "id": "40", "role": "left", "text": "要求平台给出书面拒绝理由" },
    { "id": "41", "role": "left", "text": "补交订单、设备和监护关系材料" },
    { "id": "42", "role": "left", "text": "同时保留每次客服沟通记录" },
    { "id": "43", "role": "left", "text": "仍不处理可向消保渠道投诉" },
    { "id": "44", "role": "left", "text": "金额较大时再评估起诉平台" },
    { "id": "45", "role": "right", "text": "法院主要会看哪些问题" },
    { "id": "46", "role": "left", "text": "孩子年龄、金额和消费频率" },
    { "id": "47", "role": "left", "text": "谁实际操作及平台审核情况" },
    { "id": "48", "role": "left", "text": "家长是否知情或事后追认" },
    { "id": "49", "role": "left", "text": "双方对损失是否存在过错" },
    { "id": "50", "role": "right", "text": "以后怎么防止他再充值" },
    { "id": "51", "role": "left", "text": "立即修改支付密码并关闭免密" },
    { "id": "52", "role": "left", "text": "开启青少年模式和支付限额" },
    { "id": "53", "role": "left", "text": "实名账号不要继续交给孩子使用" },
    { "id": "54", "role": "right", "text": "我先整理账单和打赏时间线" },
    { "id": "55", "role": "left", "text": "对，先固定证据再走退款流程" },
    {
      "id": "fee-receipt",
      "role": "left",
      "text": "",
      "kind": "transfer",
      "transferId": "consultation-fee",
      "transferAmount": "500.00",
      "transferState": "received"
    }
  ]
}
