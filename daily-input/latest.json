    {
      "id": "164",
      "role": "left",
      "text": "保存新医院的诊断和手术记录"
    },
    {
      "id": "165",
      "role": "left",
      "text": "还要让新医院记录断板情况"
    },
    {
      "id": "166",
      "role": "left",
      "text": "避免病历只写患者自行描述"
    },
    {
      "id": "167",
      "role": "right",
      "text": "我能主张哪些损失"
