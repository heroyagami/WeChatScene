    {
      "id": "006",
      "role": "left",
      "text": "先别只盯着骑手个人"
    },
    {
      "id": "007",
      "role": "left",
      "text": "先把事故和用工关系分开查"
    },
    {
      "id": "008",
      "role": "left",
      "text": "事故是什么时候发生的"
    },
    {
      "id": "009",
      "role": "right",
      "text": "昨晚八点多"
    },
    {
      "id": "010",
      "role": "left",
      "text": "你当时走在哪里"
    },
    {
      "id": "011",
      "role": "right",
      "text": "有信号灯的斑马线上"
    },
    {
      "id": "012",
      "role": "left",
      "text": "信号灯和双方通行状态呢"
    },
    {
      "id": "013",
      "role": "right",
      "text": "我是绿灯，他从侧面冲过来"
    },
    {
      "id": "014",
      "role": "left",
      "text": "交警是否到场"
    },
    {
      "id": "015",
      "role": "right",
      "text": "到场了，车和手机都扣了"
    },
    {
      "id": "016",
      "role": "left",
      "text": "事故认定书出来了吗"
    },
    {
      "id": "017",
      "role": "right",
      "text": "还没有，只给了受理凭证"
    },
    {
      "id": "018",
      "role": "left",
      "text": "先向交警补交现场证据"
    },
    {
      "id": "019",
      "role": "left",
      "text": "包括监控线索和目击人电话"
    },
    {
      "id": "020",
      "role": "right",
      "text": "路口商铺可能拍到了"
    },
    {
      "id": "021",
      "role": "left",
      "text": "今天就书面申请调取"
    },
    {
      "id": "022",
      "role": "left",
      "text": "监控常会被自动覆盖"
    },
    {
      "id": "023",
      "role": "right",
      "text": "骑手当时正在送单"
    },
    {
      "id": "024",
      "role": "left",
      "text": "你怎么确认的"
    },
    {
      "id": "025",
      "role": "right",
      "text": "他手机一直响，还说快超时了"
    },
    {
      "id": "026",
      "role": "left",
      "text": "记下订单号和收餐地址了吗"
    },
    {
      "id": "027",
      "role": "right",
      "text": "交警拍了手机，我没看到订单号"
    },
    {
      "id": "028",
      "role": "left",
      "text": "可申请交警固定派单页面"
    },
    {
      "id": "029",
      "role": "left",
      "text": "还要固定接单、取餐和路线时间"
    },
    {
      "id": "030",
      "role": "right",
      "text": "他穿着某平台的衣服"
    },
    {
      "id": "031",
      "role": "left",
      "text": "衣服标识只能作为线索"
    },
    {
      "id": "032",
      "role": "left",
      "text": "不能单独证明谁承担用工责任"
    },
    {
      "id": "033",
      "role": "left",
      "text": "骑手说自己属于哪家公司"
    },
    {
      "id": "034",
      "role": "right",
      "text": "说是平台众包，签约公司不清楚"
    },
    {
      "id": "035",
      "role": "left",
      "text": "让交警记录其实名和账号信息"
    },
    {
      "id": "036",
      "role": "left",
      "text": "再从订单、结算账户查主体"
    },
    {
      "id": "037",
      "role": "right",
      "text": "平台客服只说不是他们员工"
    },
    {
      "id": "038",
      "role": "left",
      "text": "客服口头答复不是最终结论"
    },
    {
      "id": "039",
      "role": "left",
      "text": "关键看实际接单和管理模式"
    },
    {
      "id": "040",
      "role": "right",
      "text": "哪些情况平台更可能担责"
    },
    {
      "id": "041",
      "role": "left",
      "text": "若平台直接招用并管理骑手"
    },
    {
      "id": "042",
      "role": "left",
      "text": "送餐属于执行工作任务"
    },
    {
      "id": "043",
      "role": "left",
      "text": "用人单位通常承担侵权责任"
    },
    {
      "id": "044",
      "role": "right",
      "text": "那如果是外包公司呢"
    },
    {
      "id": "045",
      "role": "left",
      "text": "先看谁招募、发薪和日常考核"
    },
    {
      "id": "046",
      "role": "left",
      "text": "外包公司若实际用工"
    },
    {
      "id": "047",
      "role": "left",
      "text": "可能由外包公司承担用工责任"
    },
    {
      "id": "048",
      "role": "left",
      "text": "平台存在选任或管理过错"
    },
    {
      "id": "049",
      "role": "left",
      "text": "仍可能按其过错承担相应责任"
    },
    {
      "id": "050",
      "role": "right",
      "text": "众包骑手就只能找他个人吗"
    },
    {
      "id": "051",
      "role": "left",
      "text": "也不能只凭众包名称下结论"
    },
    {
      "id": "052",
      "role": "left",
      "text": "法院会看平台是否实质控制"
    },
    {
      "id": "053",
      "role": "left",
      "text": "比如派单、定价、奖惩和封号"
    },
    {
      "id": "054",
      "role": "left",
      "text": "还会看骑手能否自由拒单"
    },
    {
      "id": "055",
      "role": "left",
      "text": "收入是否主要来自该平台"
    },
    {
      "id": "056",
      "role": "right",
      "text": "他每天都在这个平台跑"
    },
    {
      "id": "057",
      "role": "left",
      "text": "这需要流水和接单记录印证"
    },
    {
      "id": "058",
      "role": "left",
      "text": "若只是独立接单的个人"
    },
    {
      "id": "059",
      "role": "left",
      "text": "骑手本人可能直接承担责任"
    },
    {
      "id": "060",
      "role": "left",
      "text": "接受劳务的一方是否担责"
    },
    {
      "id": "061",
      "role": "left",
      "text": "仍要结合双方具体关系判断"
    },
    {
      "id": "062",
      "role": "right",
      "text": "我能把平台和外包一起告吗"
    },
    {
      "id": "063",
      "role": "left",
      "text": "主体暂不清时可先共同列为被告"
    },
    {
      "id": "064",
      "role": "left",
      "text": "再申请法院调取后台协议"
    },
    {
      "id": "065",
      "role": "left",
      "text": "让各方说明招募和结算链条"
    },
    {
      "id": "066",
      "role": "left",
      "text": "避免只告骑手后发现其无财产"
    },
    {
      "id": "067",
      "role": "right",
      "text": "骑手电动车有没有保险"
    },
    {
      "id": "068",
      "role": "left",
      "text": "先确认车辆性质和投保情况"
    },
    {
      "id": "069",
      "role": "left",
      "text": "电动自行车通常没有交强险"
    },
    {
      "id": "070",
      "role": "left",
      "text": "若属于电动摩托车则另行核查"
    },
    {
      "id": "071",
      "role": "left",
      "text": "还要问平台有无骑手责任险"
    },
    {
      "id": "072",
      "role": "right",
      "text": "骑手说平台每天扣保险费"
    },
    {
      "id": "073",
      "role": "left",
      "text": "这很重要，保存他的说明"
    },
    {
      "id": "074",
      "role": "left",
      "text": "要求提供保单号和承保公司"
    },
    {
      "id": "075",
      "role": "left",
      "text": "保险是否赔看条款和事故情形"
    },
    {
      "id": "076",
      "role": "left",
      "text": "不要接受客服一句不赔"
    },
    {
      "id": "077",
      "role": "right",
      "text": "我现在已经住院做了手术"
    },
    {
      "id": "078",
      "role": "left",
      "text": "伤情和费用也要完整固定"
    },
    {
      "id": "079",
      "role": "left",
      "text": "保存病历、诊断和费用票据"
    },
    {
      "id": "080",
      "role": "left",
      "text": "医保结算单也不要丢"
    },
    {
      "id": "081",
      "role": "left",
      "text": "医嘱需要护理和休养吗"
    },
    {
      "id": "082",
      "role": "right",
      "text": "医生写了休养三个月"
    },
    {
      "id": "083",
      "role": "left",
      "text": "保存劳动合同和工资流水"
    },
    {
      "id": "084",
      "role": "left",
      "text": "用于证明误工损失"
    },
    {
      "id": "085",
      "role": "right",
      "text": "我爱人请假照顾我"
    },
    {
      "id": "086",
      "role": "left",
      "text": "保留护理必要性医嘱"
    },
    {
      "id": "087",
      "role": "left",
      "text": "以及护理人的收入减少材料"
    },
    {
      "id": "088",
      "role": "right",
      "text": "后续还要取钢板"
    },
    {
      "id": "089",
      "role": "left",
      "text": "请医院写明后续治疗建议"
    },
    {
      "id": "090",
      "role": "left",
      "text": "费用可待实际发生后再主张"
    },
    {
      "id": "091",
      "role": "left",
      "text": "证据充分时也可评估一并处理"
    },
    {
      "id": "092",
      "role": "right",
      "text": "我能现在做伤残鉴定吗"
    },
    {
      "id": "093",
      "role": "left",
      "text": "一般等治疗终结且伤情稳定"
    },
    {
      "id": "094",
      "role": "left",
      "text": "过早鉴定可能影响结论可靠性"
    },
    {
      "id": "095",
      "role": "left",
      "text": "可由双方协商或诉中委托"
    },
    {
      "id": "096",
      "role": "right",
      "text": "可以主张哪些损失"
    },
    {
      "id": "097",
      "role": "left",
      "text": "通常包括合理医疗费"
    },
    {
      "id": "098",
      "role": "left",
      "text": "还可能有误工、护理和交通费"
    },
    {
      "id": "099",
      "role": "left",
      "text": "营养费要结合医嘱和伤情"
    },
    {
      "id": "100",
      "role": "left",
      "text": "构成伤残再评残疾赔偿等"
    },
    {
      "id": "101",
      "role": "left",
      "text": "具体数额需按证据和标准核算"
    },
    {
      "id": "102",
      "role": "right",
      "text": "交警如果认定我也有责任呢"
    },
    {
      "id": "103",
      "role": "left",
      "text": "事故责任是重要依据"
    },
    {
      "id": "104",
      "role": "left",
      "text": "但民事比例仍由证据综合判断"
    },
    {
      "id": "105",
      "role": "left",
      "text": "你的过错可能影响赔偿比例"
    },
    {
      "id": "106",
      "role": "right",
      "text": "骑手逆行又闯红灯"
    },
    {
      "id": "107",
      "role": "left",
      "text": "先让监控和认定书把它固定"
    },
    {
      "id": "108",
      "role": "left",
      "text": "不要只依赖双方口头描述"
    },
    {
      "id": "109",
      "role": "right",
      "text": "对方家属说愿意先付一万元"
    },
    {
      "id": "110",
      "role": "left",
      "text": "可以收合理垫付款"
    },
    {
      "id": "111",
      "role": "left",
      "text": "书面写明只是医疗费垫付"
    },
    {
      "id": "112",
      "role": "left",
      "text": "不代表一次性结清全部责任"
    },
    {
      "id": "113",
      "role": "right",
      "text": "平台让我签一个关怀金协议"
    },
    {
      "id": "114",
      "role": "left",
      "text": "签前先看有无免责或终结条款"
    },
    {
      "id": "115",
      "role": "left",
      "text": "特别注意放弃追偿的表述"
    },
    {
      "id": "116",
      "role": "left",
      "text": "关怀金不应被写成全部赔偿"
    },
    {
      "id": "117",
      "role": "right",
      "text": "如果他们一直拖怎么办"
    },
    {
      "id": "118",
      "role": "left",
      "text": "先给骑手、平台和外包发函"
    },
    {
      "id": "119",
      "role": "left",
      "text": "要求保全订单和用工数据"
    },
    {
      "id": "120",
      "role": "left",
      "text": "同步向交警申请材料复印"
    },
    {
      "id": "121",
      "role": "left",
      "text": "治疗稳定后汇总损失清单"
    },
    {
      "id": "122",
      "role": "left",
      "text": "谈不成可向有管辖权法院起诉"
    },
    {
      "id": "123",
      "role": "right",
      "text": "起诉要等事故认定书吗"
    },
    {
      "id": "124",
      "role": "left",
      "text": "不一定必须等"
    },
    {
      "id": "125",
      "role": "left",
      "text": "但认定书通常有重要证明作用"
    },
    {
      "id": "126",
      "role": "left",
      "text": "紧急时可先做证据或财产保全"
    },
    {
      "id": "127",
      "role": "right",
      "text": "我怕骑手把车和钱转走"
    },
    {
      "id": "128",
      "role": "left",
      "text": "可先查车辆、保险和收款主体"
    },
    {
      "id": "129",
      "role": "left",
      "text": "有明确财产线索再评估保全"
    },
    {
      "id": "130",
      "role": "left",
      "text": "申请保全通常需要提供担保"
    },
    {
      "id": "131",
      "role": "right",
      "text": "诉讼时效多久"
    },
    {
      "id": "132",
      "role": "left",
      "text": "人身损害请求一般为三年"
    },
    {
      "id": "133",
      "role": "left",
      "text": "起算和中断要按具体事实判断"
    },
    {
      "id": "134",
      "role": "left",
      "text": "不要因反复协商拖过时效"
    },
    {
      "id": "135",
      "role": "right",
      "text": "我今天先做什么"
    },
    {
      "id": "136",
      "role": "left",
      "text": "第一，书面申请保全路口监控"
    },
    {
      "id": "137",
      "role": "left",
      "text": "第二，取得骑手和订单信息"
    },
    {
      "id": "138",
      "role": "left",
      "text": "第三，查平台、外包和保险主体"
    },
    {
      "id": "139",
      "role": "left",
      "text": "第四，整理病历票据及误工材料"
    },
    {
      "id": "140",
      "role": "left",
      "text": "第五，任何协议签前逐条审查"
    },
    {
      "id": "141",
      "role": "right",
      "text": "如果平台删了订单怎么办"
    },
    {
      "id": "142",
      "role": "left",
      "text": "你先发送明确的保全通知"
    },
    {
      "id": "143",
      "role": "left",
      "text": "后续可申请法院责令提交数据"
    },
    {
      "id": "144",
      "role": "left",
      "text": "无正当理由拒交可能承担后果"
    },
    {
      "id": "145",
      "role": "right",
      "text": "明白，我先去交警队"
    },
    {
      "id": "146",
      "role": "left",
      "text": "把受理凭证和病历先分类备份"
    },
    {
      "id": "147",
      "role": "left",
      "text": "原件留存，提交时使用复印件"
    },
    {
      "id": "148",
      "role": "left",
      "text": "责任要看证据链，先别接受定责"
    },
