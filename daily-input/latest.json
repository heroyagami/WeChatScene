    {
      "id": "159",
      "role": "left",
      "text": "暂时自付的票据全部保存"
    },
    {
      "id": "160",
      "role": "left",
      "text": "最终由责任认定和证据结算"
    },
    {
      "id": "161",
      "role": "right",
      "text": "可以去别的医院做手术吗"
