    {
      "id": "155",
      "role": "left",
      "text": "律师函不是起诉的必经程序"
    },
    {
      "id": "156",
      "role": "left",
      "text": "但可集中列明证据和赔偿方案"
    },
    {
      "id": "157",
      "role": "left",
      "text": "同时再次要求保全内部记录"
    },
    {
      "id": "158",
      "role": "right",
      "text": "诉讼时效多久"
    },
    {
      "id": "159",
      "role": "left",
      "text": "合同赔偿请求一般适用三年时效"
    },
    {
      "id": "160",
      "role": "left",
      "text": "具体从知道权利受损等时间判断"
    },
    {
      "id": "161",
      "role": "left",
      "text": "投诉协商不宜被当成无限延长期限"
    },
    {
      "id": "162",
      "role": "right",
      "text": "运费和保价费有什么区别"
