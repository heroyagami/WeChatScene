    },
    {
      "id": "146",
      "role": "right",
      "text": "是否需要做抛物轨迹鉴定"
    },
    {
      "id": "147",
      "role": "left",
      "text": "先看公安勘查和现场资料是否完整"
    },
    {
      "id": "148",
      "role": "left",
      "text": "争议较大可申请相关专业鉴定"
    },
    {
      "id": "149",
      "role": "left",
      "text": "鉴定需有准确落点和建筑数据"
    },
    {
      "id": "150",
      "role": "left",
      "text": "现场已改变会降低鉴定可靠性"
    },
    {
      "id": "151",
      "role": "left",
      "text": "是否鉴定要权衡费用和证明价值"
    },
    {
      "id": "152",
      "role": "right",
      "text": "我妈能主张哪些费用"
    },
    {
      "id": "153",
      "role": "left",
      "text": "可主张合理医疗费和护理费"
    },
    {
      "id": "154",
      "role": "left",
      "text": "还可审查误工费和交通费"
    },
    {
      "id": "155",
      "role": "left",
      "text": "住院伙食补助等按证据计算"
    },
    {
      "id": "156",
      "role": "left",
      "text": "伤情稳定后再评估是否构成伤残"
    },
    {
      "id": "157",
      "role": "left",
      "text": "后续治疗费应有医学依据"
    },
    {
      "id": "158",
      "role": "left",
      "text": "精神损害结合伤情后果判断"
    },
    {
      "id": "159",
      "role": "right",
      "text": "护理是我请假完成的"
    },
    {
      "id": "160",
      "role": "left",
      "text": "保存劳动合同和工资流水"
    },
    {
      "id": "161",
      "role": "left",
      "text": "让单位出具请假及扣薪证明"
    },
    {
      "id": "162",
      "role": "left",
      "text": "护理必要性和期限结合医嘱"
    },
    {
      "id": "163",
      "role": "right",
      "text": "车辆贬值也能要求吗"
    },
    {
      "id": "164",
      "role": "left",
      "text": "先区分维修费和交易性贬值"
    },
    {
      "id": "165",
      "role": "left",
      "text": "普通维修后贬值并非当然支持"
    },
    {
      "id": "166",
      "role": "left",
      "text": "需结合车辆受损程度和证据判断"
    },
    {
      "id": "167",
      "role": "left",
      "text": "替代交通费也要证明实际合理"
    },
    {
      "id": "168",
      "role": "right",
      "text": "诉讼前能要求先付医药费吗"
    },
    {
      "id": "169",
      "role": "left",
      "text": "可协商合理的应急垫付款"
    },
    {
      "id": "170",
      "role": "left",
      "text": "收据注明只是医疗费垫付"
    },
    {
      "id": "171",
      "role": "left",
      "text": "不要写成全部纠纷一次性结清"
    },
    {
      "id": "172",
      "role": "left",
      "text": "伤情未稳定时慎签终局协议"
    },
    {
      "id": "173",
      "role": "right",
      "text": "物业让我们签保密协议才垫付"
    },
    {
      "id": "174",
      "role": "left",
      "text": "先审查保密范围和违约责任"
    },
    {
      "id": "175",
      "role": "left",
      "text": "不能以删除证据作为付款条件"
    },
    {
      "id": "176",
      "role": "left",
      "text": "也不能妨碍依法报警和诉讼"
    },
    {
      "id": "177",
      "role": "left",
      "text": "合理隐私保护可另行约定"
    },
    {
      "id": "178",
      "role": "right",
      "text": "需要申请财产保全吗"
    },
    {
      "id": "179",
      "role": "left",
      "text": "先看责任主体和损失规模"
    },
    {
      "id": "180",
      "role": "left",
      "text": "对明确侵权人可调查财产线索"
    },
    {
      "id": "181",
      "role": "left",
      "text": "可能加害住户较多时要谨慎"
    },
    {
      "id": "182",
      "role": "left",
      "text": "保全金额应与请求范围相匹配"
    },
    {
      "id": "183",
      "role": "left",
      "text": "错误保全可能产生赔偿风险"
    },
    {
      "id": "184",
      "role": "right",
      "text": "诉讼时效怎么计算"
    },
    {
      "id": "185",
      "role": "left",
      "text": "侵权请求通常有三年时效"
    },
    {
      "id": "186",
      "role": "left",
      "text": "一般从知道损害及义务人时起算"
    },
    {
      "id": "187",
      "role": "left",
      "text": "义务人尚未查明时需具体分析"
    },
    {
      "id": "188",
      "role": "left",
      "text": "但监控和现场证据不会等三年"
    },
    {
      "id": "189",
      "role": "left",
      "text": "应立即调查并及时主张权利"
    },
    {
      "id": "190",
      "role": "right",
      "text": "现在最优先做哪些事"
    },
    {
      "id": "191",
      "role": "left",
      "text": "第一，治疗并完整保存医疗资料"
    },
    {
      "id": "192",
      "role": "left",
      "text": "第二，固定花盆碎片和落点"
    },
    {
      "id": "193",
      "role": "left",
      "text": "第三，保全全部监控和门禁记录"
    },
    {
      "id": "194",
      "role": "left",
      "text": "第四，推动公安持续调查"
    },
    {
      "id": "195",
      "role": "left",
      "text": "第五，查物业巡查和报修记录"
    },
    {
      "id": "196",
      "role": "left",
      "text": "第六，筛选可能加害的房屋范围"
    },
    {
      "id": "197",
      "role": "left",
      "text": "第七，整理人伤和车辆损失"
    },
    {
      "id": "198",
      "role": "left",
      "text": "第八，再确定被告和诉讼请求"
    },
    {
      "id": "199",
      "role": "right",
      "text": "可以先让社区组织调解吗"
    },
    {
      "id": "200",
      "role": "left",
      "text": "可以，但不能因此停止取证"
    },
    {
      "id": "201",
      "role": "left",
      "text": "调解记录中避免替各方预认责任"
    },
    {
      "id": "202",
      "role": "left",
      "text": "付款、追偿和后续费用要写清"
    },
    {
      "id": "203",
      "role": "left",
      "text": "未查明行为人时慎签全面放弃"
    },
    {
      "id": "204",
      "role": "right",
      "text": "明白了，我先申请保存监控"
    },
    {
      "id": "205",
      "role": "left",
      "text": "同时把报警和医疗材料整理好"
    },
    {
      "id": "206",
      "role": "left",
      "text": "查明范围后再确定责任主体"
    },
