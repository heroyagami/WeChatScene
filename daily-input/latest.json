    {
      "id": "35",
      "role": "left",
      "text": "向有管辖权的人社部门申请"
    },
    {
      "id": "36",
      "role": "left",
      "text": "各地受理口径可能略有差异"
    },
    {
      "id": "37",
      "role": "left",
      "text": "先向参保地或用工地窗口核实"
