    {
      "id": "28",
      "role": "left",
      "text": "一般应在事故伤害后三十日内"
    },
    {
      "id": "29",
      "role": "left",
      "text": "特殊情况可按规定申请延长"
    },
    {
      "id": "30",
      "role": "right",
      "text": "公司不申请我怎么办"
    },
    {
      "id": "31",
      "role": "left",
      "text": "你或近亲属可自行申请认定"
    },
    {
      "id": "32",
      "role": "left",
      "text": "一般期限是事故发生后一年内"
