  "messages": [
    {"id":"01","role":"right","text":"曹律，公司突然通知我调去仓库"},
    {"id":"02","role":"right","text":"我原来一直做销售"},
    {"id":"03","role":"right","text":"底薪八千要降到五千"},
    {"id":"04","role":"right","text":"我不去，他们说按旷工处理"},
    {"id":"05","role":"left","text":"500"},
    {"id":"fee-sent","role":"right","text":"","kind":"transfer","transferId":"consultation-fee","transferAmount":"500.00","transferState":"accepted"},
    {"id":"fee-receipt","role":"left","text":"","kind":"transfer","transferId":"consultation-fee","transferAmount":"500.00","transferState":"received"},
    {"id":"08","role":"left","text":"劳动合同岗位怎么写"},
    {"id":"09","role":"right","text":"写的是销售专员"},
    {"id":"10","role":"left","text":"调岗通知是书面的吗"},
    {"id":"11","role":"right","text":"邮件发的，说组织架构调整"},
    {"id":"12","role":"left","text":"你最近绩效有问题吗"},
    {"id":"13","role":"right","text":"没有，上月还是部门第二"},
    {"id":"14","role":"left","text":"那先不要直接拒绝上班"},
    {"id":"15","role":"right","text":"为什么，调岗明显不合理啊"},
    {"id":"16","role":"left","text":"不合理也不等于可以旷工"},
    {"id":"17","role":"left","text":"这是很多人最容易踩的坑"},
    {"id":"18","role":"left","text":"明天照常到公司打卡"},
    {"id":"19","role":"left","text":"同时书面提出调岗异议"},
    {"id":"20","role":"right","text":"怎么写最稳"},
    {"id":"21","role":"left","text":"可以直接写三句话"},
    {"id":"22","role":"left","text":"本人不同意本次调岗降薪"},
    {"id":"23","role":"left","text":"我愿按原合同继续提供劳动"},
    {"id":"24","role":"left","text":"请安排原岗位或协商解决"},
    {"id":"25","role":"right","text":"微信发给人事可以吗"},
    {"id":"26","role":"left","text":"可以，最好邮件也同步"},
    {"id":"27","role":"right","text":"如果不让我进办公室呢"},
    {"id":"28","role":"left","text":"到公司全过程尽量留证"},
    {"id":"29","role":"left","text":"门禁、打卡、定位都保存"},
    {"id":"30","role":"left","text":"被拦门外可以录像"},
    {"id":"31","role":"left","text":"再给人事发消息说明已到岗"},
    {"id":"32","role":"right","text":"他们逼我签调岗确认书呢"},
    {"id":"33","role":"left","text":"不同意就别随便签"},
    {"id":"34","role":"left","text":"尤其别签自愿降薪"},
    {"id":"35","role":"left","text":"也别签个人原因离职"},
    {"id":"36","role":"right","text":"他们说不签就辞退"},
    {"id":"37","role":"left","text":"那让公司出书面解除决定"},
    {"id":"38","role":"left","text":"别替公司写辞职申请"},
    {"id":"39","role":"right","text":"真辞退我能要2N吗"},
    {"id":"40","role":"left","text":"先看解除理由是否合法"},
    {"id":"41","role":"left","text":"如果属于违法解除"},
    {"id":"42","role":"left","text":"可主张继续履行或赔偿金"},
    {"id":"43","role":"left","text":"但不是一辞退就自动2N"},
    {"id":"44","role":"right","text":"如果只发五千工资呢"},
    {"id":"45","role":"left","text":"工资流水和工资表都保存"},
    {"id":"46","role":"left","text":"可主张被少发的工资差额"},
    {"id":"47","role":"right","text":"还要留哪些证据"},
    {"id":"48","role":"left","text":"合同、调岗通知、聊天记录"},
    {"id":"49","role":"left","text":"考勤、工资流水、历史绩效"},
    {"id":"50","role":"right","text":"为什么绩效也要留"},
    {"id":"51","role":"left","text":"防止公司以后改口"},
    {"id":"52","role":"left","text":"说你不能胜任原岗位"},
    {"id":"53","role":"left","text":"你业绩靠前会很重要"},
    {"id":"54","role":"right","text":"我现在最关键做什么"},
    {"id":"55","role":"left","text":"正常到岗，书面异议，留证"},
    {"id":"56","role":"left","text":"不主动制造旷工证据"},
    {"id":"57","role":"left","text":"让公司决定下一步怎么走"},
    {"id":"58","role":"right","text":"明白，明天先正常打卡"},
    {"id":"59","role":"left","text":"对，通知下来再发我看"}
  ]
}
