    {
      "id": "38",
      "role": "right",
      "text": "我应该准备哪些证据"
    },
    {
      "id": "39",
      "role": "left",
      "text": "先保存交通事故责任认定书"
    },
    {
      "id": "40",
      "role": "left",
      "text": "再备急诊病历和诊断证明"
    },
    {
      "id": "41",
      "role": "left",
      "text": "保留现场照片、监控和报警记录"
    },
    {
      "id": "42",
      "role": "left",
      "text": "导航轨迹可证明通勤路线"
    },
    {
      "id": "43",
      "role": "left",
      "text": "打卡记录可证明下班时间"
    },
    {
      "id": "44",
      "role": "right",
      "text": "没有劳动合同会被卡住吗"
    },
    {
      "id": "45",
      "role": "left",
      "text": "还要准备工资流水和工作证"
    },
    {
      "id": "46",
      "role": "left",
      "text": "考勤、工牌、聊天都可辅助证明"
    },
    {
      "id": "47",
      "role": "left",
      "text": "劳动关系有争议时可能先行处理"
    },
    {
      "id": "48",
      "role": "right",
      "text": "住院费用现在谁先付"
    },
    {
      "id": "49",
      "role": "left",
      "text": "先治疗并保留全部票据清单"
