    {
      "id": "53",
      "role": "left",
      "text": "两条路径的责任基础不同"
    },
    {
      "id": "54",
      "role": "left",
      "text": "具体项目是否抵扣看当地规则"
    },
    {
      "id": "55",
      "role": "left",
      "text": "不要笼统理解成可以重复获赔"
    },
    {
      "id": "56",
      "role": "right",
      "text": "公司让我先签自愿放弃工伤"
